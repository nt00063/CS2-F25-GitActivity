<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.westga.cs1302.project3.view.AddComicWindow">

    <center>
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="Comic Title:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="titleTextField"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Issue Number:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="issueNumberTextField"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="center">
            <padding>
                <Insets top="10" bottom="10"/>
            </padding>

            <children>
                <Button fx:id="confirmButton"
                        text="Add Comic"
                        onAction="#handleConfirm"/>

                <Button fx:id="cancelButton"
                        text="Cancel"
                        onAction="#handleCancel"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
