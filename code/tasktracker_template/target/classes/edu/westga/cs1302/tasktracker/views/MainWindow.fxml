<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="720" prefWidth="400" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.tasktracker.MainWindow">

    <children>
        <!-- Task Name -->
        <Label layoutX="10" layoutY="10" text="Task Name:" />
        <TextField fx:id="nameField" layoutX="120" layoutY="10" prefWidth="250" />

        <!-- Description -->
        <Label layoutX="10" layoutY="50" text="Description:" />
        <TextArea fx:id="descriptionArea" layoutX="120" layoutY="50" prefHeight="80" prefWidth="250" />

        <!-- Priority -->
        <Label layoutX="10" layoutY="150" text="Priority:" />
        <ComboBox fx:id="priorityComboBox" layoutX="120" layoutY="150" prefWidth="150" />

        <!-- Add Task Button -->
        <Button layoutX="280" layoutY="150" onAction="#handleAddTask" text="Add Task" />

        <!-- Task List -->
        <ListView fx:id="taskListView" layoutX="10" layoutY="200" prefHeight="350" prefWidth="360" />

        <!-- Selected Task Display -->
        <Label layoutX="10" layoutY="570" text="Selected Task Description:" />
        <TextArea fx:id="selectedDescriptionArea" layoutX="150" layoutY="570" prefHeight="60" prefWidth="220" />

        <Label layoutX="10" layoutY="640" text="Selected Task Priority:" />
        <TextField fx:id="selectedPriorityField" editable="false" layoutX="150" layoutY="640" prefWidth="100" />

        <!-- Optional: Button to display selected task -->
        <Button layoutX="260" layoutY="640" onAction="#handleDisplaySelectedTask" text="Show Selected Task" />
      <Button layoutX="42.0" layoutY="600.0" mnemonicParsing="false" onAction="#handleUpdateDescription" text="Update Description" />
    </children>
</AnchorPane>
